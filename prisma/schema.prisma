generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  password     String
  role         String        @default("student")
  noAi         Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  interactions Interaction[]
  letters      Letter[]
  reviews      Review[]
  stories      Story[]
  dramas       Drama[]
  poetries     Poetry[]
  profile      UserProfile?
  reviewsReceived WorkReview[] @relation("AuthorReviews")
  reviewsGiven   WorkReview[] @relation("ReviewerReviews")

  @@map("users")
}

model UserProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl  String?  @db.Text
  avatarEmoji String?
  birthday   String?
  email      String?
  grade      String?
  gender     String?
  /// JSON 数组：最多 12 棵树，每棵 { id: number; stage: 1-6 }
  trees      Json?
  /// JSON 对象：每棵树的成长详情记录，key 为树 id，value 为成长详情数组
  treeGrowthDetails Json?
  /// 上一次写作三指标，用于判断哪一项提升最大：{ vocabRichness, descriptiveAccuracy, logicalCoherence }
  lastMetrics Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("user_profiles")
}

model WorkReview {
  id             String   @id @default(cuid())
  workType       String   // "story" | "bookReview" | "letter"
  workInteractionId String? // interaction id or story/review/letter id for the work
  authorId       String   // user who wrote the work
  author         User     @relation("AuthorReviews", fields: [authorId], references: [id], onDelete: Cascade)
  reviewerId     String   // user who wrote the review
  reviewer       User     @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerRole   String   // "teacher" | "student"
  content        String   @db.Text
  workTitle      String?  // optional title for display
  workContent    String?  @db.Text // snapshot of work content for display
  readAt         DateTime? // when author read this review (for notification)
  createdAt      DateTime @default(now())

  @@index([authorId])
  @@index([reviewerId])
  @@map("work_reviews")
}

model Interaction {
  id        String   @id @default(cuid())
  userId    String
  stage     String
  timestamp DateTime @default(now())
  apiCalls  Json?
  input     Json?
  output    Json?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  letters   Letter?
  reviews   Review?
  stories   Story?
  drama     Drama?
  poetry    Poetry?

  @@index([userId])
  @@index([stage])
  @@index([timestamp])
  @@map("interactions")
}

model Story {
  id            String       @id @default(cuid())
  userId        String
  interactionId String?      @unique
  content       String       @default("")
  character     Json?
  plot          Json?
  structure     Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  interactions  Interaction? @relation(fields: [interactionId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("stories")
}

model Review {
  id            String       @id @default(cuid())
  userId        String
  interactionId String?      @unique
  content       String       @default("")
  bookTitle     String?
  reviewType    String?
  coverImage    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  bookCoverUrl  String?
  bookSummary   String?
  structure     Json?
  interactions  Interaction? @relation(fields: [interactionId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("reviews")
}

model Letter {
  id             String       @id @default(cuid())
  userId         String
  interactionId  String?      @unique
  content        String       @default("")
  recipient      String?
  occasion       String?
  readerImage    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  guidance       String?
  readerImageUrl String?
  sections       Json?
  interactions   Interaction? @relation(fields: [interactionId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("letters")
}

model Drama {
  id            String       @id @default(cuid())
  userId        String
  interactionId String?      @unique
  title         String?
  content       String       @default("") @db.Text
  summary       String?      @db.Text
  suggestions   Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  interactions  Interaction? @relation(fields: [interactionId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("dramas")
}

model Poetry {
  id            String       @id @default(cuid())
  userId        String
  interactionId String?      @unique
  form          String?
  topic         String?
  content       String       @default("") @db.Text
  lines         Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  interactions  Interaction? @relation(fields: [interactionId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("poetries")
}

/// Snapshots from Story / Book Review / Letter edit-stage saves (teacher sees V1, V2, …).
model WritingEditRevision {
  id        String   @id @default(cuid())
  workType  String // "story" | "review" | "letter"
  workId    String
  version   Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@unique([workType, workId, version])
  @@index([workType, workId])
  @@map("writing_edit_revisions")
}

// ─── ADMIN MODELS ───────────────────────────────────────────────────────────

model Admin {
  id            String    @id @default(cuid())
  username      String    @unique
  passwordHash  String
  role          String    // "admin" | "teacher"
  name          String?
  email         String?
  assignedClass String?   // e.g. "P3" — used for teacher role filtering
  canExportData Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?

  auditLogs      AuditLog[]
  researchNotes  ResearchNote[]

  @@map("admins")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String   // "login" | "view_user" | "export" | "update_user" | "delete_user"
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model ResearchNote {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  userId    String   // the student being annotated
  workId    String?
  workType  String?  // "story" | "review" | "letter" | "drama" | "poetry"
  content   String   @db.Text
  tag       String?  // "positive" | "needs_improvement" | "note"
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([userId])
  @@map("research_notes")
}
